	<queryString>
		<![CDATA[SELECT 
    a.NIS, 
    s.Nama, 
    s.Kelas, 
    a.Status, 
    a.Waktu_Masuk, 
    a.Waktu_Pulang, 
    a.Tanggal
FROM 
    absensi a
JOIN 
    siswa s ON a.NIS = s.NIS;]]>
	</queryString>
